{
  "name": "@gramaziokohler/llhil-webxr",
  "version": "1.0.0",
  "description": "WebXR for three.js scenes: VR at 1:1 with teleport and viewpoints, and AR placement.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gramaziokohler/LLHIL_WebXR.git"
  },
  "keywords": [
    "three",
    "webxr",
    "vr",
    "ar",
    "architecture"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "tsdown",
    "dev": "vite --config examples/viewer/vite.config.ts",
    "build:viewer": "vite build --config examples/viewer/vite.config.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "size": "size-limit"
  },
  "peerDependencies": {
    "three": ">=0.182.0 <0.190.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.3",
    "@iwer/sem": "2.7.0",
    "@playwright/test": "1.63.0",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@types/node": "^22.10.0",
    "@types/three": "0.186.0",
    "@types/webxr": "0.5.24",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "happy-dom": "^20.0.0",
    "iwer": "2.7.0",
    "size-limit": "^11.2.0",
    "three": "0.186.1",
    "tsdown": "^0.23.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
